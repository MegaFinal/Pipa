    "No Pipa, a IA lê a foto: os produtos de uma nota fiscal ou os ingredientes de uma receita." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pipa, AI reads the photo: a receipt's products or a recipe's ingredients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Pipa, la IA lee la foto: los productos de un ticket o los ingredientes de una receta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Pipa, l’IA lit la photo : les produits d’un ticket ou les ingrédients d’une recette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipaでは、AIが写真からレシートの商品やレシピの材料を読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipa에서 AI가 사진 속 영수증 상품이나 레시피 재료를 읽어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Pipa 里，AI 会读取照片里小票的商品或菜谱的食材。"
          }
        }
      }
    },
